QWidget {
    background-color: #1E1E1E;
    color: #F2F2F2;
    font-family: 'Segoe UI';
    font-size: 14px;
}

QLineEdit {
    background: #2B2B2B;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 6px;
    color: #EEE;
}
QLineEdit:focus {
    border: 1px solid #0A84FF;
}

QPushButton {
    background: #2F2F2F;
    border-radius: 8px;
    padding: 6px 12px;
    border: none;
}
QPushButton:hover {
    background: #3A3A3A;
}
QPushButton:pressed {
    background: #242424;
    margin-top: 1px;
    margin-left: 1px;
}

QPushButton#SidebarToggle {
    max-width: 32px;
    min-width: 32px;
    padding: 4px;
    border-radius: 6px;
}

QTableWidget {
    background: #1E1E1E;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    gridline-color: #333;
}
QHeaderView::section {
    background: #2C2C2C;
    padding: 6px;
    font-weight: bold;
    color: #EAEAEA;
    border: none;
}
QTableWidget::item:selected {
    background: #31394F;
}
QTableWidget::item:hover {
    background: #262626;
}

QListWidget {
    background: #2C2C2E;
    border: none;
    border-radius: 8px;
}
QListWidget::item {
    padding: 6px 10px;
}
QListWidget::item:selected {
    background: #3A3A3C;
    border-radius: 6px;
}
