QWidget {
    background-color: #F5F5F7;
    color: #1C1C1E;
    font-family: 'Segoe UI';
    font-size: 14px;
}

QLineEdit {
    background: white;
    border: 1px solid #D2D2D7;
    border-radius: 6px;
    padding: 6px;
}
QLineEdit:focus {
    border: 1px solid #007AFF;
}

QPushButton {
    background: #E5E5EA;
    border-radius: 8px;
    padding: 6px 12px;
    border: none;
}
QPushButton:hover {
    background: #D1D1D6;
}
QPushButton:pressed {
    background: #C7C7CC;
    margin-top: 1px;
    margin-left: 1px;
}

QPushButton#SidebarToggle {
    max-width: 32px;
    min-width: 32px;
    padding: 4px;
    border-radius: 6px;
}

QTableWidget {
    background-color: white;
    border: 1px solid #D2D2D7;
    border-radius: 8px;
    gridline-color: #E5E5EA;
}
QHeaderView::section {
    background: #EFEFF4;
    padding: 6px;
    font-weight: bold;
    border: none;
}
QTableWidget::item:selected {
    background: #D7E3FC;
    color: #1C1C1E;
}
QTableWidget::item:hover {
    background: #F0F0F0;
}

QListWidget {
    background: #EFEFF4;
    border: none;
    border-radius: 8px;
}
QListWidget::item {
    padding: 6px 10px;
}
QListWidget::item:selected {
    background: #D1D1D6;
    border-radius: 6px;
}
